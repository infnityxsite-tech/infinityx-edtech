# Required server secrets (Netlify Functions only; never prefix with VITE_)
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=https://your-site.netlify.app,https://your-domain.example
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Required public Firebase client configuration (visible in the browser)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id

# Application identity
VITE_APP_ID=infinityx_production
VITE_APP_TITLE=InfinityX

# Optional AI grading providers (configure at least one for automatic grading)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Optional legacy Forge integrations
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional local/Render-only controls; never enabled by the Netlify Function
PORT=3000
AUTO_INITIALIZE_DATABASE=false
